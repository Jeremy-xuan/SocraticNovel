{
  "name": "socratic-engine",
  "version": "0.0.1",
  "description": "SocraticNovel P1 teaching-engine plugin for DeepSeek Harness: manifest-driven classroom injection (position+frequency), phase store, teaching tools. Skeleton.",
  "type": "module",
  "main": "./index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./lib/manifest.mjs": "./lib/manifest.mjs",
    "./lib/injector.mjs": "./lib/injector.mjs",
    "./lib/phasestore.mjs": "./lib/phasestore.mjs",
    "./lib/diagram.mjs": "./lib/diagram.mjs",
    "./lib/diagramstore.mjs": "./lib/diagramstore.mjs",
    "./lib/mermaid-parse.mjs": "./lib/mermaid-parse.mjs",
    "./lib/mermaid-worker.mjs": "./lib/mermaid-worker.mjs",
    "./lib/animation.mjs": "./lib/animation.mjs",
    "./lib/animationstore.mjs": "./lib/animationstore.mjs",
    "./lib/animtemplates.mjs": "./lib/animtemplates.mjs",
    "./lib/prep.mjs": "./lib/prep.mjs",
    "./lib/prepstore.mjs": "./lib/prepstore.mjs",
    "./lib/expression.mjs": "./lib/expression.mjs",
    "./lib/expressionstore.mjs": "./lib/expressionstore.mjs",
    "./lib/expression-table.json": "./lib/expression-table.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "jsdom": "^30.1.1",
    "mermaid": "^11.17.2",
    "yaml": "^2.6.1"
  },
  "files": [
    "index.mjs",
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
