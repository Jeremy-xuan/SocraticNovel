{
  "name": "socratic-narrative",
  "version": "0.3.0",
  "description": "SocraticNovel 叙事层（车道 N）：N1 独立上下文 agent 运行器 + N2 日记 + N3 群聊（K4 服务）+ N4 定时主动消息。零运行时依赖（不引入任何 @deepseek-ai/* 包，见 README「宿主包纪律」）。",
  "type": "module",
  "main": "./index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./typert": "./lib/typert.host.mjs",
    "./lib/runner.mjs": "./lib/runner.mjs",
    "./lib/protocol.mjs": "./lib/protocol.mjs",
    "./lib/state.mjs": "./lib/state.mjs",
    "./lib/runlog.mjs": "./lib/runlog.mjs",
    "./lib/atomic.mjs": "./lib/atomic.mjs",
    "./lib/serial.mjs": "./lib/serial.mjs",
    "./lib/lock.mjs": "./lib/lock.mjs",
    "./lib/errors.mjs": "./lib/errors.mjs",
    "./lib/diary.mjs": "./lib/diary.mjs",
    "./lib/trigger.mjs": "./lib/trigger.mjs",
    "./lib/text.mjs": "./lib/text.mjs",
    "./lib/time.mjs": "./lib/time.mjs",
    "./lib/classroom.mjs": "./lib/classroom.mjs",
    "./lib/groupstore.mjs": "./lib/groupstore.mjs",
    "./lib/group.mjs": "./lib/group.mjs",
    "./lib/groupservice.mjs": "./lib/groupservice.mjs",
    "./lib/noteswrite.mjs": "./lib/noteswrite.mjs",
    "./lib/proactive.mjs": "./lib/proactive.mjs",
    "./lib/typert.host.mjs": "./lib/typert.host.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
