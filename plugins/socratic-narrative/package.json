{
  "name": "socratic-narrative",
  "version": "0.1.0",
  "description": "SocraticNovel 叙事层地基（车道 N）：N1 独立上下文 agent 运行器 + N2 日记。零运行时依赖（不引入任何 @deepseek-ai/* 包，见 README「宿主包纪律」）。",
  "type": "module",
  "main": "./index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./lib/runner.mjs": "./lib/runner.mjs",
    "./lib/protocol.mjs": "./lib/protocol.mjs",
    "./lib/state.mjs": "./lib/state.mjs",
    "./lib/runlog.mjs": "./lib/runlog.mjs",
    "./lib/atomic.mjs": "./lib/atomic.mjs",
    "./lib/serial.mjs": "./lib/serial.mjs",
    "./lib/errors.mjs": "./lib/errors.mjs",
    "./lib/diary.mjs": "./lib/diary.mjs",
    "./lib/trigger.mjs": "./lib/trigger.mjs",
    "./lib/text.mjs": "./lib/text.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
